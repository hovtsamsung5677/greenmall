# Относительный путь: запросы идут на тот же origin, что и страница.
# В dev это проксируется на backend (server.proxy в vite.config.ts),
# благодаря чему страница маршрута работает и на телефоне в локальной сети.
VITE_API_BASE_URL=/api

# Базовый адрес для QR-кода с маршрутом.
# Оставьте пустым, чтобы использовался текущий origin браузера (рекомендуется в dev).
# ВАЖНО: http://localhost:5173 здесь работать НЕ будет — на телефоне localhost
# указывает на сам телефон. Укажите LAN-адрес компьютера, например:
# VITE_SHARE_BASE_URL=http://192.168.1.111:5173
VITE_SHARE_BASE_URL=
